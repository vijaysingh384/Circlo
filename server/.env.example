# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server port
PORT=3001

# Backend URL (used for generating absolute image URLs)
BACKEND_URL=http://localhost:3001

# MongoDB connection string
# Local: mongodb://localhost:27017/circlo
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/circlo
MONGODB_URI=mongodb://localhost:27017/circlo

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Cloudinary configuration (for photo storage)
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=drebkrygv
CLOUDINARY_API_KEY=379395385757459
CLOUDINARY_API_SECRET=**********
