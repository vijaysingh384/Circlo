# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server port
PORT=3001

# MongoDB connection string
# Local: mongodb://localhost:27017/circlo
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/circlo
MONGODB_URI=mongodb://localhost:27017/circlo

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Optional: Cloudflare R2 or S3 configuration (for cloud storage)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
